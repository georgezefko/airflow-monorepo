<mxfile host="app.diagrams.net">
  <diagram id="deploy-flow" name="Build and deploy flow">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="From merge to running: team code comes from git, only the platform's Airflow image is built" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="40" as="geometry"/></mxCell>

        <mxCell id="laneA" value="airflow-monorepo (this repo)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="560" as="geometry"/></mxCell>
        <mxCell id="laneB" value="GCP: Artifact Registry" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="240" height="560" as="geometry"/></mxCell>
        <mxCell id="laneC" value="Deploy repo (GitOps)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="260" height="560" as="geometry"/></mxCell>
        <mxCell id="laneD" value="Kubernetes (kind, later GKE)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#e8f4f8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="320" height="560" as="geometry"/></mxCell>

        <mxCell id="merge" value="&lt;b&gt;Team PR merged to main&lt;/b&gt;&lt;br&gt;&lt;small&gt;fix(sales): … in teams/sales/&lt;br&gt;DAGs, dbt models, SQL: nothing to build&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="platform" value="&lt;b&gt;Platform change&lt;/b&gt;&lt;br&gt;&lt;small&gt;Dockerfile or plugins/&lt;br&gt;build.yaml builds the Airflow image&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="release" value="&lt;b&gt;Team merges its release PR&lt;/b&gt;&lt;br&gt;&lt;small&gt;chore(sales): release 1.5.0&lt;br&gt;creates the git tag sales-v1.5.0&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="240" height="70" as="geometry"/></mxCell>

        <mxCell id="ar" value="&lt;b&gt;airflow:&amp;lt;sha&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;small&gt;Airflow, Cosmos, dbt CLI, plugins/&lt;br&gt;the only image (apps come later)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="250" width="200" height="70" as="geometry"/></mxCell>

        <mxCell id="devv" value="&lt;b&gt;envs/dev/values.yaml&lt;/b&gt;&lt;br&gt;&lt;small&gt;Airflow image: &amp;lt;sha&amp;gt;&lt;br&gt;every bundle: tracking_ref main&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="prodv" value="&lt;b&gt;envs/prod/values.yaml&lt;/b&gt;&lt;br&gt;&lt;small&gt;platform: platform-v1.0.0&lt;br&gt;sales: sales-v1.4.0 → sales-v1.5.0&lt;br&gt;marketing: marketing-v1.2.0&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="220" height="90" as="geometry"/></mxCell>

        <mxCell id="argo" value="&lt;b&gt;Argo CD&lt;/b&gt;&lt;br&gt;&lt;small&gt;keeps the cluster equal to the deploy repo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="250" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="airflow" value="&lt;b&gt;Airflow&lt;/b&gt; (Airflow image)&lt;br&gt;&lt;small&gt;GitDagBundle per team: a checkout of the whole repo&lt;br&gt;at the team's ref; DAGs from teams/&amp;lt;team&amp;gt;/dags&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="pods" value="&lt;b&gt;Task pods&lt;/b&gt; (Airflow image)&lt;br&gt;&lt;small&gt;dbt runs from the same checkout,&lt;br&gt;only path:teams/&amp;lt;team&amp;gt;/dbt&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="370" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="bq" value="&lt;b&gt;BigQuery&lt;/b&gt;&lt;br&gt;&lt;small&gt;analytics_staging · _sales · _marketing&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="970" y="500" width="260" height="60" as="geometry"/></mxCell>

        <mxCell id="e1" value="1. dev bundles fetch main (git, no build)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="merge" target="airflow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. one task per model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="airflow" target="pods"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. build tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="pods" target="bq"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p1" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;fontColor=#7F6000;" edge="1" parent="1" source="platform" target="ar"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2" value="dev image = &amp;lt;sha&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;fontColor=#7F6000;" edge="1" parent="1" source="ar" target="devv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3" value="sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="devv" target="argo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="argo" target="airflow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d1" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d79b00;fontColor=#994C00;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="ar" target="pods"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="405"/></Array></mxGeometry></mxCell>

        <mxCell id="r1" value="promotion PR: only sales' tracking_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;fontColor=#6F2DA8;" edge="1" parent="1" source="release" target="prodv"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note" value="A team's version is one git tag for its DAGs, dbt models and SQL together. Dev's bundles follow main; prod's bundles each point at a team's release tag, so a sales release never moves marketing. The worker checks out the exact commit a DAG run started with. Rollback: point the bundle back at the previous tag. Prod runs in its own cluster and GCP project, synced by Argo CD the same way." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="635" width="1240" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
