<mxfile host="app.diagrams.net">
  <diagram id="deploy-flow" name="Build and deploy flow">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="From merge to running in dev: this repo builds, the deploy repo decides what runs" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="40" as="geometry"/></mxCell>

        <mxCell id="laneA" value="airflow-monorepo (this repo)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="540" as="geometry"/></mxCell>
        <mxCell id="laneB" value="GCP: registry and storage" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="240" height="540" as="geometry"/></mxCell>
        <mxCell id="laneC" value="Deploy repo (GitOps)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="260" height="540" as="geometry"/></mxCell>
        <mxCell id="laneD" value="Kubernetes · dev (kind, later GKE)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;fillColor=#e8f4f8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="320" height="540" as="geometry"/></mxCell>

        <mxCell id="merge" value="&lt;b&gt;PR merged to main&lt;/b&gt;&lt;br&gt;&lt;small&gt;e.g. sales changes daily_orders.sql&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="ci" value="&lt;b&gt;build.yaml&lt;/b&gt; (CI on main)&lt;br&gt;&lt;small&gt;a. build and push dbt:&amp;lt;sha&amp;gt;&lt;br&gt;b. dbt parse, upload manifest&lt;br&gt;c. set the dev tag in the deploy repo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="dagonly" value="&lt;b&gt;DAG-only change&lt;/b&gt;&lt;br&gt;&lt;small&gt;no image build: Airflow pulls DAG code from git&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="tag" value="&lt;b&gt;Team cuts a release tag&lt;/b&gt;&lt;br&gt;&lt;small&gt;sales-v1.4.0 (prod only)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="240" height="60" as="geometry"/></mxCell>

        <mxCell id="ghcr" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;&lt;small&gt;dbt:&amp;lt;sha&amp;gt; on every merge&lt;br&gt;airflow:&amp;lt;version&amp;gt; rarely, platform team&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="gcs" value="&lt;b&gt;GCS&lt;/b&gt;&lt;br&gt;&lt;small&gt;manifests/&amp;lt;sha&amp;gt;/manifest.json&lt;br&gt;manifests/main/ (slim CI defers here)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="260" width="200" height="80" as="geometry"/></mxCell>

        <mxCell id="devv" value="&lt;b&gt;envs/dev/values.yaml&lt;/b&gt;&lt;br&gt;&lt;small&gt;dbt image: &amp;lt;latest main sha&amp;gt;&lt;br&gt;bundles track main&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="prodv" value="&lt;b&gt;envs/prod/values.yaml&lt;/b&gt;&lt;br&gt;&lt;small&gt;platform: platform-v1.0.0&lt;br&gt;sales: sales-v1.4.0&lt;br&gt;marketing: marketing-v1.2.0&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="660" y="480" width="220" height="100" as="geometry"/></mxCell>

        <mxCell id="argo" value="&lt;b&gt;Argo CD&lt;/b&gt;&lt;br&gt;&lt;small&gt;keeps the cluster equal to the deploy repo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="airflow" value="&lt;b&gt;Airflow&lt;/b&gt; (airflow image)&lt;br&gt;&lt;small&gt;GitDagBundle per team: platform · sales · marketing&lt;br&gt;Cosmos builds tasks from the manifest&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="220" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="pods" value="&lt;b&gt;dbt pods&lt;/b&gt; (dbt:&amp;lt;sha&amp;gt;)&lt;br&gt;&lt;small&gt;one pod per model, Cosmos KUBERNETES mode&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="370" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="bq" value="&lt;b&gt;BigQuery&lt;/b&gt; · dev project&lt;br&gt;&lt;small&gt;analytics_staging · _sales · _marketing&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="970" y="500" width="260" height="60" as="geometry"/></mxCell>

        <mxCell id="e1" value="1. push to main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="merge" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="ci" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="ci" target="gcs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="4. commit dev tag = &amp;lt;sha&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ci" target="devv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="200"/><mxPoint x="620" y="200"/><mxPoint x="620" y="95"/><mxPoint x="770" y="95"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="5. sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="devv" target="argo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="6. deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="argo" target="airflow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="7. one task per model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="airflow" target="pods"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="8. build tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="pods" target="bq"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="d1" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontColor=#994C00;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="ghcr" target="pods"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="230"/><mxPoint x="610" y="230"/><mxPoint x="610" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="d2" value="read manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontColor=#994C00;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gcs" target="airflow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3" value="git pull DAG code (GitDagBundle)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="dagonly" target="airflow"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="410"/><mxPoint x="920" y="340"/><mxPoint x="1035" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="p1" value="promotion PR: moves only sales" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#6F2DA8;strokeColor=#9673a6;" edge="1" parent="1" source="tag" target="prodv"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note" value="Dev follows main automatically: every merge runs in dev within minutes, with no develop branch and no second PR. Prod has its own cluster and GCP project: Argo CD syncs envs/prod the same way, and each team moves its own tag, so a sales release never moves marketing. Images are tagged with the commit SHA and never overwritten, so a rollback is moving a tag back." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="615" width="1240" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
